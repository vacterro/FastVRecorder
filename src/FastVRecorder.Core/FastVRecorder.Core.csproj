<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FastVRecorder.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure managed DSP (WdlResampler) only; no OS-specific APIs are used from Core. -->
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Languages\*.json">
      <LogicalName>FastVRecorder.Core.Languages.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FastVRecorder.Core.Tests" />
    <InternalsVisibleTo Include="FastVRecorder.Integration.Tests" />
  </ItemGroup>

</Project>
