<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Initial Golden Default values. ThemeService replaces these at startup and on theme switch. -->
    <SolidColorBrush x:Key="Brush.Background" Color="#1A1810" />
    <SolidColorBrush x:Key="Brush.BackgroundSoft" Color="#232018" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#332E22" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#3D372A" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#453D30" />
    <SolidColorBrush x:Key="Brush.Border" Color="#5A5040" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#100E08" />
    <SolidColorBrush x:Key="Brush.Bevel" Color="#75663D" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#F0D060" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#F5DC7A" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#1A1810" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#D4C89A" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9C9371" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6E674E" />
    <SolidColorBrush x:Key="Brush.Recording" Color="#D66464" />
    <SolidColorBrush x:Key="Brush.Success" Color="#4A7A20" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#7A7A20" />
    <SolidColorBrush x:Key="Brush.Error" Color="#7A2020" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#3D372A" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#F0D060" />
    <SolidColorBrush x:Key="Brush.Teal" Color="#008080" />
    <SolidColorBrush x:Key="Brush.TealDeep" Color="#004C4C" />

    <FontFamily x:Key="Font.Ui">Verdana</FontFamily>
    <sys:Double x:Key="Font.Size">11</sys:Double>
</ResourceDictionary>
