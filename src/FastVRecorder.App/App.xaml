<Application x:Class="FastVRecorder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FastVRecorder.App.Converters"
             xmlns:vm="clr-namespace:FastVRecorder.App.ViewModels"
             xmlns:views="clr-namespace:FastVRecorder.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Base.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVis" />
            <conv:SeverityBrushConverter x:Key="SeverityBrush" />

            <DataTemplate DataType="{x:Type vm:RecorderViewModel}">
                <views:RecorderView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HotkeysViewModel}">
                <views:HotkeysView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
