<UserControl x:Class="FastVRecorder.App.Views.RecorderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastVRecorder.App"
             xmlns:controls="clr-namespace:FastVRecorder.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,10,14,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Recording}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Focus}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11.5" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding [Rec.Pause], Source={x:Static local:Loc.Instance}}"
                        Command="{Binding PauseCommand}"
                        Style="{StaticResource SmallButton}"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <TextBlock Text="{Binding TimerText}"
                       FontFamily="Consolas"
                       FontSize="34"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,2"
                       Foreground="{DynamicResource Brush.TextPrimary}" />

            <controls:LevelMeter Height="28" Margin="2,0,2,4" Value="{Binding Level}" />

            <TextBlock Text="{Binding [Rec.NoSignal], Source={x:Static local:Loc.Instance}}"
                       Foreground="{DynamicResource Brush.Recording}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="{Binding ShowNoSignalWarning, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="{Binding [Rec.Microphone], Source={x:Static local:Loc.Instance}}"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,0,0,3" />
            <ComboBox ItemsSource="{Binding Settings.Devices}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding Settings.SelectedDeviceChoice, Mode=TwoWay}"
                      IsEnabled="{Binding Settings.IsRecordingIdle}" />

            <Button Command="{Binding ToggleCommand}"
                    Content="{Binding RecordButtonText}"
                    Height="46"
                    Margin="0,12,0,0"
                    FontSize="12">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Tag" Value="recording" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Recording}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Recording}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <TextBlock Text="{Binding [Rec.Hotkey], Source={x:Static local:Loc.Instance}}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Settings.ToggleHotkeyText}"
                           FontSize="10.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Accent}"
                           Margin="6,0,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding Settings.OutputDescription}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource MutedText}"
                       Margin="0,8,0,0" />

            <TextBlock Text="{Binding FileNameText}"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,3,0,0" />

            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="8,6"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding [Rec.Folder], Source={x:Static local:Loc.Instance}}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Settings.FolderDisplay}"
                                   Style="{StaticResource SecondaryText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding [Rec.OpenFolder], Source={x:Static local:Loc.Instance}}"
                            Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource SmallButton}"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0" />
                </Grid>
            </Border>

            <Grid Margin="0,5,0,0">
                <TextBlock Text="{Binding FreeSpaceText}" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding [Rec.LowDisk], Source={x:Static local:Loc.Instance}}"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.Recording}"
                           FontSize="10"
                           Visibility="{Binding IsLowDisk, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <TextBlock Text="{Binding [Rec.AppliesNext], Source={x:Static local:Loc.Instance}}"
                       Style="{StaticResource MutedText}"
                       Margin="0,9,0,0"
                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="{Binding [Rec.CueTooltip], Source={x:Static local:Loc.Instance}}"
                       Style="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="0,7,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
