<Window x:Class="FastVRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FastVRecorder.App"
        Title="{Binding [App.Title], Source={x:Static local:Loc.Instance}}"
        Width="380" Height="460"
        MinWidth="340" MinHeight="400"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource Font.Size}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="{Binding Settings.ShowTaskbarIcon}"
        FlowDirection="{Binding FlowDirection, Source={x:Static local:Loc.Instance}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <TextBlock Text="{Binding [App.Title], Source={x:Static local:Loc.Instance}}"
                           Foreground="{DynamicResource Brush.Accent}"
                           FontWeight="Bold"
                           FontSize="12" />
                <TextBlock Text="{Binding Settings.VersionText}"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           FontSize="9.5"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="8,6"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding BannerText}"
                           TextWrapping="Wrap"
                           FontSize="10"
                           Foreground="{Binding BannerSeverity, Converter={StaticResource SeverityBrush}}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="×"
                        Command="{Binding DismissBannerCommand}"
                        Style="{StaticResource IconButton}"
                        Margin="6,0,0,0"
                        ToolTip="{Binding [Common.Dismiss], Source={x:Static local:Loc.Instance}}" />
            </Grid>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentVm}" />

        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <UniformGrid Columns="4">
                <ToggleButton Style="{StaticResource NavButton}"
                              Content="{Binding [Nav.Recorder], Source={x:Static local:Loc.Instance}}"
                              IsChecked="{Binding IsRecorderPage, Mode=OneWay}"
                              Command="{Binding ShowRecorderCommand}" />
                <ToggleButton Style="{StaticResource NavButton}"
                              Content="{Binding [Nav.History], Source={x:Static local:Loc.Instance}}"
                              IsChecked="{Binding IsHistoryPage, Mode=OneWay}"
                              Command="{Binding ShowHistoryCommand}" />
                <ToggleButton Style="{StaticResource NavButton}"
                              Content="{Binding [Nav.Hotkeys], Source={x:Static local:Loc.Instance}}"
                              IsChecked="{Binding IsHotkeysPage, Mode=OneWay}"
                              Command="{Binding ShowHotkeysCommand}" />
                <ToggleButton Style="{StaticResource NavButton}"
                              Content="{Binding [Nav.Settings], Source={x:Static local:Loc.Instance}}"
                              IsChecked="{Binding IsSettingsPage, Mode=OneWay}"
                              Command="{Binding ShowSettingsCommand}" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>
